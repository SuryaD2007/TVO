# Public URL used for canonical links, sitemap, and OG images
NEXT_PUBLIC_SITE_URL=https://example.com

# Application storage (optional in dev; submissions are logged when unset)
SUPABASE_URL=
# Publishable key (sb_publishable_...). Kept server-side; the table only permits inserts.
SUPABASE_KEY=

# Optional: post new applications to a Slack channel
SLACK_WEBHOOK_URL=

# Signs admin sessions + challenge codes and derives the admin DB key.
# Generate with: openssl rand -hex 32
# After changing it, re-seed private.admin_keys (see supabase/migrations/*admin_and_status.sql).
APP_SECRET=
# Password for /admin
ADMIN_PASSWORD=
# Keyed hash of the terminal challenge answer, computed with APP_SECRET.
# See the comment in src/lib/secrets.ts for the one-line command.
CHALLENGE_ANSWER_HMAC=

# Optional AI sprint planner. Tried in order: Claude, then Gemini, then a keyword estimate.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional: Gemini models to try, comma-separated (default shown)
# GEMINI_MODELS=gemini-2.5-flash,gemini-flash-latest,gemini-flash-lite-latest
# Hard daily cap on AI planner calls across all visitors (then it serves quick estimates)
# PLAN_DAILY_AI_LIMIT=300

# Cloudflare Turnstile bot protection (Cloudflare dashboard → Turnstile → Add site)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Emails via Resend (resend.com): applicant confirmations + operator alerts
RESEND_API_KEY=
# An address on a domain you've verified in Resend
EMAIL_FROM="TVO <apply@yourdomain.com>"
# Where new-application alerts go; comma-separated for several people
OPERATOR_EMAIL=
